APP_NAME="Delivery Tracking"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-railway-domain.up.railway.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=error

# Railway MySQL variables are MYSQLHOST, MYSQLPORT, MYSQLDATABASE,
# MYSQLUSER, and MYSQLPASSWORD. The database config uses them automatically.
DB_CONNECTION=mysql

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_COOKIE=delivery-tracking-session
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
